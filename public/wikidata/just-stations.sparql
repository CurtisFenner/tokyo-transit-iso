SELECT DISTINCT
  ?station
  ?station_en
  ?station_ja
  ?station_coordinate
  ?station_codes
  ?lines
WHERE {
  wd:Q548662 ^wdt:P279*/^wdt:P31 ?station .
  ?station wdt:P17 wd:Q17 .
  # Exclude former stations
#   FILTER NOT EXISTS { ?station wdt:P31/wdt:P279* wd:Q4663385. }.
  FILTER NOT EXISTS { wd:Q4663385 ^wdt:P279*/^wdt:P31 ?station . }.
  # Exclude state-of-use=decommissioned stations
  FILTER NOT EXISTS { ?station wdt:P5817 wd:Q11639308 }.

  OPTIONAL { ?station wdt:P625 ?station_coordinate }

  OPTIONAL {
    SELECT ?station (GROUP_CONCAT(DISTINCT ?station_code; SEPARATOR=",") AS ?station_codes)
           WHERE {
             ?station wdt:P296 ?station_code .
           }
    GROUP BY ?station
  }

  OPTIONAL {
    SELECT ?station (GROUP_CONCAT(DISTINCT ?line; SEPARATOR=",") AS ?lines)
    WHERE {
      ?station wdt:P81|wdt:P1192 ?line .
    }
    GROUP BY ?station
  }

  OPTIONAL { ?station rdfs:label ?station_en filter (lang(?station_en) = "en") }.
  OPTIONAL { ?station rdfs:label ?station_ja filter (lang(?station_ja) = "ja") }.
}
